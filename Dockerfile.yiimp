FROM ubuntu:24.04 AS baseimage

ENV DEBIAN_FRONTEND=noninteractive

RUN set -xe \
    && : "---------- Fix possible vulnerabilities ----------" \
    && apt-get update && apt-get dist-upgrade -y \
    && : "---------- add tools ----------" \
    && apt-get install -y git bc dumb-init supervisor cron logrotate vim less nano mc memcached haproxy apache2 libapache2-mod-php sudo \
    && : "---------- add build-tools ----------" \
    && apt-get install -y automake autotools-dev build-essential libtool libasan6 python3 python3-venv libaugeas0 \
    && : "---------- Persistent dependencies ----------" \
    && apt-get install -y libgd-dev libicu-dev libmariadb-dev-compat libxml2-dev libonig-dev libcurl4-openssl-dev libssl-dev libxslt1-dev libzip-dev libz-dev libmemcached-dev libgmp-dev libsodium-dev libmcrypt-dev \
    && : "---------- php extensions ----------" \
    && apt-get install -y \
        php-cli php-dev \
        php-bcmath php-curl php-exif php-gd php-intl \
        php-memcache php-opcache php-mbstring \
        php-mysql \
        php-soap php-shmop php-sysvshm php-sysvsem php-sysvmsg \
        php-xml php-xsl php-zip \
    && apt-get clean

RUN set -xe \
    && : "---------- Copy latest composer ----------"
COPY --from=docker.io/library/composer:latest /usr/bin/composer /usr/bin/composer

RUN set -xe \
    && : "---------- Modify apache config ----------" \
    && a2enmod remoteip \
    && a2enmod rewrite

COPY config/000-default.conf /etc/apache2/sites-available/
COPY config/ports.conf /etc/apache2/
RUN echo "RemoteIPHeader x-forwarded-for" >> /etc/apache2/apache2.conf \
    && echo "RemoteIPInternalProxy 127.0.0.1" >> /etc/apache2/apache2.conf

# enable yii2-port on alternate vhost
COPY config/001-yiimp2.conf /etc/apache2/sites-available/
RUN a2ensite 001-yiimp2

# add php-mcrypt from pecl (required by legacy web/ app; not needed by yiimp2)
# uses dynamic PHP version to avoid hardcoded path breakage on future PHP upgrades
RUN pecl install mcrypt
RUN PHP_VER=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;') && \
    echo "extension=mcrypt.so" >> /etc/php/${PHP_VER}/apache2/php.ini && \
    echo "extension=mcrypt.so" >> /etc/php/${PHP_VER}/cli/php.ini

# add Let's Encrypt repository in /opt
RUN python3 -m venv /opt/certbot/ && \
    /opt/certbot/bin/pip install --upgrade pip && \
    /opt/certbot/bin/pip install certbot && \
    ln -s /opt/certbot/bin/certbot /usr/bin/certbot

COPY --chmod=755 /bin/letsencrypt-* /usr/local/bin/

# build stratum binary
COPY /stratum /tmp/stratum
WORKDIR /tmp/stratum
RUN make buildonly && cp stratum /usr/bin/

# create default log directory
RUN mkdir /var/log/yiimp

# ── Tailwind CSS build ────────────────────────────────────────────────────────
# Runs in an isolated Node.js image so Node/npm never enter the production image.
# Output: web/css/tailwind.css (copied into image-prod below).
#
# Commit yiimp2/package-lock.json to source control so this stage uses
# `npm ci` for fully reproducible, lock-file-verified installs.
FROM node:20-alpine AS tailwind-build
WORKDIR /build

# Install npm deps (layer cached unless package.json changes)
COPY /yiimp2/package.json /yiimp2/package-lock.json* ./
RUN npm install --prefer-offline

# Copy only the files the Tailwind CLI content-scanner needs
COPY /yiimp2/tailwind.config.js ./
COPY /yiimp2/src/             ./src/
COPY /yiimp2/views/           ./views/
COPY /yiimp2/components/      ./components/

# Compile — writes to web/css/tailwind.css (relative to package.json)
RUN mkdir -p web/css && npm run build

# Build devel image
FROM baseimage as image-devel

RUN set -xe \
    && : "---------- changes only on devel env e.g. enable xdebug ----------" \
    && apt-get install -y php-xdebug

COPY /config/xdebug.ini /usr/local/etc/php/conf.d/

WORKDIR /var/www/
CMD ["apache2-foreground"]

# Build production image
FROM baseimage as image-prod

# Deploy legacy web app
COPY --chown=www-data:www-data /web/ /var/www/

# Deploy yiimp2 app and install production PHP dependencies
COPY --chown=www-data:www-data /yiimp2/ /var/yiimp2/

WORKDIR /var/yiimp2/
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Copy pre-compiled Tailwind CSS from the build stage.
# YIIMP_TAILWIND_CDN defaults to true (CDN mode) so this file is only used
# when an operator sets YIIMP_TAILWIND_CDN=false in serverconfig.php.
COPY --from=tailwind-build --chown=www-data:www-data \
    /build/web/css/tailwind.css /var/yiimp2/web/css/tailwind.css

# Ensure the Yii2 runtime and asset directories are writable by www-data
RUN mkdir -p /var/yiimp2/runtime /var/yiimp2/web/assets \
    && chown -R www-data:www-data /var/yiimp2/runtime /var/yiimp2/web/assets

WORKDIR /var/www/

COPY /config/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Use dumb-init as PID 1 for correct signal forwarding and zombie reaping
CMD ["/usr/bin/dumb-init", "--", "/usr/bin/supervisord"]
